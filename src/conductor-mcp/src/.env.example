# Conductor MCP Environment Variables

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database
POSTGRES_URI=postgresql://postgres:password@localhost:5432/email_automation
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/email_logs

# Message Queue
RABBITMQ_URI=amqp://guest:guest@localhost:5672
EMAIL_EXCHANGE=email_exchange
EMAIL_QUEUE=email_classification

# External Services
EMAIL_MCP_URL=http://localhost:3002

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# Intent Analysis Settings
CACHE_TTL=3600  # In seconds
MAX_TOKENS=150
MODEL_TEMPERATURE=0.3
AUTO_PROCESS_THRESHOLD=0.85  # Confidence threshold for auto-processing

# Application Settings
ENABLE_LLM_CLASSIFICATION=true  # Set to false to use only rule-based classification 
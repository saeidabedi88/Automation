# Email MCP Environment Variables

# Server
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# Database
POSTGRES_URI=postgresql://postgres:password@localhost:5432/email_automation

# Message Queue
RABBITMQ_URI=amqp://guest:guest@localhost:5672
EMAIL_EXCHANGE=email_exchange
INCOMING_EMAIL_QUEUE=incoming_emails
RESPONSE_QUEUE=email_responses

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# Email Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=no-reply@yourcompany.com

# Application Settings
AUTO_SEND_LOW_RISK=false  # Set to true to automatically send low-risk responses without human review 